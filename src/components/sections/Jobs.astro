---
import { jobs, education, certifications } from '../../data/portfolio.js';

const views = [
  {
    id: 'experience',
    label: 'Experience',
    items: jobs.map((job) => ({
      tab: job.tabLabel || job.company,
      title: job.title,
      org: job.company,
      orgUrl: job.url,
      range: job.range,
      links: job.relatedLinks || [],
      bullets: job.bullets,
    })),
  },
  {
    id: 'education',
    label: 'Education',
    items: [
      ...education.map((item) => ({
        tab: item.institution,
        title: item.program,
        org: item.institution,
        range: item.range,
        links: [],
        bullets: item.specialization ? [`Specialization: ${item.specialization}`] : [],
      })),
      ...certifications.map((item) => ({
        tab: 'ISTQB',
        title: item.title,
        org: item.issuer,
        range: item.date,
        links: item.url ? [{ label: 'View certificate', url: item.url }] : [],
        bullets: [],
      })),
    ],
  },
];
---

<section id="jobs" class="jobs" data-jobs>
  <h2 class="numbered-heading">Experience &amp; Education</h2>

  <div class="view-tabs" role="tablist" aria-label="Experience and education">
    {views.map((view, v) => (
      <button
        type="button"
        class="view-tab"
        role="tab"
        id={`view-${view.id}`}
        aria-controls={`view-panel-${view.id}`}
        aria-selected={v === 0 ? 'true' : 'false'}
        tabindex={v === 0 ? '0' : '-1'}
        data-view={view.id}
      >
        {view.label}
      </button>
    ))}
  </div>

  {views.map((view, v) => (
    <div
      class="inner"
      id={`view-panel-${view.id}`}
      role="tabpanel"
      aria-labelledby={`view-${view.id}`}
      hidden={v !== 0}
      data-view-panel={view.id}
    >
      <div class="tab-list" role="tablist" aria-label={`${view.label} entries`}>
        <span class="marker" aria-hidden="true" />
        {view.items.map((item, i) => (
          <button
            type="button"
            class="tab"
            role="tab"
            id={`${view.id}-tab-${i}`}
            aria-controls={`${view.id}-panel-${i}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            tabindex={i === 0 ? '0' : '-1'}
          >
            {item.tab}
          </button>
        ))}
      </div>

      <div class="panels">
        {view.items.map((item, i) => (
          <div
            class="panel"
            id={`${view.id}-panel-${i}`}
            role="tabpanel"
            aria-labelledby={`${view.id}-tab-${i}`}
            hidden={i !== 0}
          >
            <h3>
              <span>{item.title}</span>{' '}
              <span class="org">
                <span class="at">@ </span>
                {item.orgUrl ? (
                  <a
                    href={item.orgUrl}
                    class="inline-link"
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    {item.org}
                  </a>
                ) : (
                  <span>{item.org}</span>
                )}
              </span>
            </h3>

            {item.range && <p class="range">{item.range}</p>}

            {item.links.length > 0 && (
              <div class="related-links">
                {item.links.map((link) => (
                  <a href={link.url} class="inline-link" target="_blank" rel="noopener noreferrer">
                    {link.label}
                  </a>
                ))}
              </div>
            )}

            {item.bullets.length > 0 && (
              <ul class="fancy-list">
                {item.bullets.map((bullet) => (
                  <li>{bullet}</li>
                ))}
              </ul>
            )}
          </div>
        ))}
      </div>
    </div>
  ))}
</section>

<script>
  // Accessible tabs: click, or arrow keys to move between tabs in a list.
  const activate = (tabs: HTMLElement[], index: number, focus = false) => {
    tabs.forEach((tab, i) => {
      const selected = i === index;
      tab.setAttribute('aria-selected', String(selected));
      tab.tabIndex = selected ? 0 : -1;
      const panel = document.getElementById(tab.getAttribute('aria-controls')!);
      if (panel) panel.hidden = !selected;
    });
    const marker = tabs[0].parentElement?.querySelector<HTMLElement>('.marker');
    marker?.style.setProperty('--marker-y', `${tabs[index].offsetTop}px`);
    if (focus) {
      tabs[index].focus();
      tabs[index].scrollIntoView({ block: 'nearest', inline: 'nearest' });
    }
  };

  document.querySelectorAll<HTMLElement>('[data-jobs] [role="tablist"]').forEach((list) => {
    const tabs = [...list.querySelectorAll<HTMLElement>(':scope > [role="tab"]')];
    tabs.forEach((tab, i) => tab.addEventListener('click', () => activate(tabs, i)));
    list.addEventListener('keydown', (e) => {
      const current = tabs.indexOf(document.activeElement as HTMLElement);
      if (current === -1) return;
      const step = { ArrowRight: 1, ArrowDown: 1, ArrowLeft: -1, ArrowUp: -1 }[e.key];
      if (!step) return;
      e.preventDefault();
      activate(tabs, (current + step + tabs.length) % tabs.length, true);
    });
  });
</script>

<style>
  .jobs {
    max-width: 700px;
  }

  .view-tabs {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: 10px 0 30px;
  }

  .view-tab {
    position: relative;
    height: 44px;
    padding: 0 12px;
    background: transparent;
    color: var(--slate);
    font-family: var(--font-mono);
    font-size: var(--fz-xxs);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .view-tab::after {
    content: '';
    position: absolute;
    left: 10px;
    right: 10px;
    bottom: 6px;
    height: 2px;
    border-radius: 999px;
    background: var(--green);
    transform: scaleX(0);
    opacity: 0;
    transition:
      transform 220ms var(--easing),
      opacity 220ms var(--easing);
  }

  .view-tab[aria-selected='true'],
  .view-tab:hover,
  .view-tab:focus-visible {
    color: var(--lightest-slate);
  }

  .view-tab[aria-selected='true']::after,
  .view-tab:hover::after {
    transform: scaleX(1);
    opacity: 1;
  }

  .inner {
    display: flex;
  }

  .inner[hidden] {
    display: none;
  }

  @media (min-width: 700px) {
    .inner {
      min-height: 340px;
    }
  }

  @media (max-width: 600px) {
    .inner {
      display: block;
    }
  }

  .tab-list {
    position: relative;
    z-index: 3;
    display: flex;
    flex-direction: column;
    width: max-content;
  }

  .tab {
    display: flex;
    align-items: center;
    width: 100%;
    height: var(--tab-height);
    padding: 0 20px 2px;
    border-left: 2px solid var(--lightest-navy);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
    background-color: transparent;
    color: var(--slate);
    font-family: var(--font-mono);
    font-size: var(--fz-xs);
    text-align: left;
    white-space: nowrap;
    transition: var(--transition);
  }

  .tab:hover,
  .tab:focus-visible {
    background-color: var(--light-navy);
    color: var(--green);
  }

  .tab[aria-selected='true'] {
    color: var(--green);
  }

  /* Accent bar that slides to the selected tab (desktop layout only). */
  .marker {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 1;
    width: 2px;
    height: var(--tab-height);
    background: var(--green);
    box-shadow: var(--glow);
    transform: translateY(var(--marker-y, 0));
    transition: transform 0.35s var(--easing);
  }

  /* On small screens the entries become a swipeable row of pills. */
  @media (max-width: 600px) {
    .tab-list {
      flex-direction: row;
      gap: 8px;
      width: calc(100% + 40px);
      margin: 0 -20px 24px;
      padding: 0 20px 4px;
      overflow-x: auto;
      scroll-snap-type: x proximity;
      scrollbar-width: none;
    }

    .tab-list::-webkit-scrollbar {
      display: none;
    }

    .tab {
      flex: 0 0 auto;
      width: auto;
      height: 44px;
      padding: 0 16px;
      scroll-snap-align: start;
      border: 1px solid var(--lightest-navy);
      border-radius: var(--radius-md);
    }

    .tab[aria-selected='true'] {
      border-color: var(--green);
    }

    .marker {
      display: none;
    }
  }

  .panels {
    width: 100%;
    margin-left: 20px;
  }

  @media (max-width: 600px) {
    .panels {
      margin-left: 0;
    }
  }

  .panel {
    padding: 10px 5px;
  }

  @media (prefers-reduced-motion: no-preference) {
    .panel:not([hidden]) {
      animation: fade 250ms var(--easing);
    }
  }

  @keyframes fade {
    from {
      opacity: 0;
    }
  }

  h3 {
    margin-bottom: 2px;
    font-size: var(--fz-xxl);
    font-weight: 500;
    line-height: 1.3;
  }

  .org {
    color: var(--green);
  }

  @media (max-width: 480px) {
    h3 {
      font-size: 20px;
    }

    .org {
      display: block;
      margin-top: 4px;
    }

    .at {
      display: none;
    }
  }

  .range {
    margin-bottom: 25px;
    color: var(--light-slate);
    font-family: var(--font-mono);
    font-size: var(--fz-xs);
  }

  .related-links {
    margin: -12px 0 22px;
    font-family: var(--font-mono);
    font-size: var(--fz-xxs);
    line-height: 1.4;
  }

  .related-links a {
    margin: 0 14px 8px 0;
  }
</style>
