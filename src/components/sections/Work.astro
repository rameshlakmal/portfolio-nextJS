---
// Home page "Work" section: an endless deck of featured projects (one card
// in front, its neighbours blurred behind it on both sides), then the latest
// few projects with a link to /projects for the rest.
import { Image } from 'astro:assets';
import ProjectIndex from '../ProjectIndex.astro';
import HoverClip from '../HoverClip.astro';
import { featuredProjects, projects } from '../../data/portfolio.js';
import { describe, external, byNewest } from '../../utils/projects.js';

// How many projects the home page lists before pointing to /projects.
const HOME_LIMIT = 6;

const featured = [...featuredProjects].sort(byNewest).map(describe);
const latest = [...projects].sort(byNewest).slice(0, HOME_LIMIT);
const total = featuredProjects.length + projects.length;
---

<section id="projects" class="work">
  <h2 class="numbered-heading">Work</h2>

  <div
    class:list={['carousel', { single: featured.length === 1 }]}
    role="region"
    aria-roledescription="carousel"
    aria-label="Featured projects"
    data-carousel
  >
    {featured.length > 1 && (
      <div class="carousel-head">
        <p class="counter" aria-live="polite">
          <span data-current>01</span> / {String(featured.length).padStart(2, '0')}
          <span class="current-title" data-current-title>
            {featured[0].title}
          </span>
        </p>
      </div>
    )}
    <div class="deck" data-deck tabindex="0">
      {featured.map((project, i) => (
        <article
          class="featured slide"
          data-featured
          data-slide={i}
          aria-roledescription="slide"
          aria-label={`${i + 1} of ${featured.length}: ${project.title}`}
        >
          <a
            class="media"
            href={project.links[0].url}
            {...external(project.links[0].url)}
            tabindex="-1"
            aria-hidden="true"
          >
            <Image
              src={project.cover}
              alt=""
              widths={[800, 1200, 1600]}
              quality={90}
              sizes="(max-width: 900px) 100vw, 560px"
            />
            <HoverClip preview={project.preview} />
          </a>
          <div class="body">
            <div class="intro">
              <p class="kind">Featured project</p>
              <h3>
                <a href={project.links[0].url} {...external(project.links[0].url)}>
                  {project.title}
                </a>
              </h3>
              <p class="description">{project.description}</p>
            </div>
            <div class="side">
              <p class="tech">{project.tech.join(', ')}</p>
              <div class="actions">
                {project.links.map((link, i) => (
                  <a
                    class={i === 0 ? 'btn-sm' : 'text-link'}
                    href={link.url}
                    {...external(link.url)}
                  >
                    {link.kind === 'app' ? 'Open app' : link.label}{' '}
                    <span aria-hidden="true">↗</span>
                  </a>
                ))}
              </div>
            </div>
          </div>
        </article>
      ))}
    </div>
    {featured.length > 1 && (
      <div class="dots" role="group" aria-label="Choose a featured project">
        {featured.map((project, i) => (
          <button
            type="button"
            class="dot"
            aria-label={`Show ${project.title}`}
            aria-current={i === 0 ? 'true' : undefined}
            data-dot={i}
          />
        ))}
      </div>
    )}
  </div>

  <div class="index-head">
    <h3>Latest work</h3>
  </div>

  <ProjectIndex projects={latest} />

  <a class="btn-sm all-button" href="/projects">
    View all {total} projects
  </a>
</section>

<script>
  import { playClip, stopClip, preloadWhenVisible } from '../../utils/hoverClip';

  // Featured deck: the current card sits in front; the previous and next
  // cards wait behind it on the left and right. It loops in both directions.
  document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((carousel) => {
    const deck = carousel.querySelector<HTMLElement>('[data-deck]')!;
    const slides = [...carousel.querySelectorAll<HTMLElement>('[data-slide]')];
    const counter = carousel.querySelector<HTMLElement>('[data-current]');
    const title = carousel.querySelector<HTMLElement>('[data-current-title]');
    const n = slides.length;
    if (n < 2) return;

    let current = 0;
    const show = (index: number) => {
      current = ((index % n) + n) % n;
      slides.forEach((slide, i) => {
        const d = (((i - current) % n) + n) % n;
        const pos =
          d === 0
            ? 'center'
            : d === 1
              ? 'right'
              : d === n - 1
                ? 'left'
                : d < n / 2
                  ? 'hidden-right'
                  : 'hidden-left';
        slide.dataset.pos = pos;
        const front = pos === 'center';
        slide.toggleAttribute('inert', !front);
        slide.setAttribute('aria-hidden', String(!front));
        if (!front) stopClip(slide.querySelector<HTMLVideoElement>('[data-clip]'));
      });
      if (counter) counter.textContent = String(current + 1).padStart(2, '0');
      if (title) title.textContent = slides[current].querySelector('h3')?.textContent?.trim() ?? '';
      carousel.querySelectorAll<HTMLElement>('[data-dot]').forEach((dot, i) => {
        if (i === current) dot.setAttribute('aria-current', 'true');
        else dot.removeAttribute('aria-current');
      });
    };

    const dots = [...carousel.querySelectorAll<HTMLButtonElement>('[data-dot]')];
    dots.forEach((dot, i) => dot.addEventListener('click', () => show(i)));
    deck.addEventListener('keydown', (e) => {
      const step = { ArrowRight: 1, ArrowLeft: -1 }[e.key];
      if (!step) return;
      e.preventDefault();
      show(current + step);
    });

    // Clicking a card behind brings it to the front. (Inert cards ignore
    // clicks, so this listens on the deck and checks which side was hit.)
    deck.addEventListener('click', (e) => {
      const front = slides[current].getBoundingClientRect();
      if (e.clientX < front.left) show(current - 1);
      else if (e.clientX > front.right) show(current + 1);
    });

    // Swipe or drag sideways to move through the deck.
    let startX: number | null = null;
    deck.addEventListener('pointerdown', (e) => (startX = e.clientX));
    deck.addEventListener('pointerup', (e) => {
      if (startX === null) return;
      const dx = e.clientX - startX;
      startX = null;
      if (Math.abs(dx) > 50) show(current + (dx < 0 ? 1 : -1));
    });

    show(0);
  });

  document.querySelectorAll<HTMLElement>('[data-featured]').forEach((card) => {
    const clip = card.querySelector<HTMLVideoElement>('[data-clip]');
    if (!clip) return;
    preloadWhenVisible([clip]);
    // Only the card in front plays its clip.
    card.addEventListener('pointerenter', () => {
      if (!card.dataset.pos || card.dataset.pos === 'center') playClip(clip);
    });
    card.addEventListener('pointerleave', () => stopClip(clip));
  });
</script>

<style>
  /* Wider than the other sections so project previews are large enough to read. */
  .work {
    max-width: 1200px;
  }

  /* Featured carousel */
  .carousel-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 14px;
  }

  .counter {
    margin: 0;
    color: var(--slate);
    font-family: var(--font-mono);
    font-size: var(--fz-sm);
  }

  .counter [data-current] {
    color: var(--green);
  }

  .current-title {
    margin-left: 12px;
    color: var(--lightest-slate);
    font-family: var(--font-sans);
    font-size: var(--fz-lg);
    font-weight: 600;
  }

  /* Dots under the deck: one per featured project, the current one wider. */
  .dots {
    display: flex;
    justify-content: center;
    gap: 6px;
    margin-top: 22px;
  }

  .dot {
    position: relative;
    width: 28px;
    height: 28px;
    background: transparent;
  }

  .dot::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 8px;
    height: 8px;
    border-radius: 4px;
    background: var(--lightest-navy);
    transform: translate(-50%, -50%);
    transition:
      width 0.3s var(--easing),
      background-color 0.3s ease;
  }

  .dot:hover::before {
    background: var(--dark-slate);
  }

  .dot[aria-current='true']::before {
    width: 24px;
    background: var(--green);
    box-shadow: var(--glow);
  }

  /* The deck runs the full width of the window; the cards behind fade out
     towards the screen edges instead of being cut off. */
  .deck {
    --card: min(1140px, 90vw);
    display: grid;
    width: 100vw;
    margin-left: calc(50% - 50vw);
    overflow-x: clip;
    padding: 6px 0;
    touch-action: pan-y;
    -webkit-mask-image: linear-gradient(
      90deg,
      transparent 0,
      #000 calc(50% - var(--card) / 2),
      #000 calc(50% + var(--card) / 2),
      transparent 100%
    );
    mask-image: linear-gradient(
      90deg,
      transparent 0,
      #000 calc(50% - var(--card) / 2),
      #000 calc(50% + var(--card) / 2),
      transparent 100%
    );
  }

  .slide {
    grid-area: 1 / 1;
    justify-self: center;
    width: var(--card);
    transition:
      transform 0.6s var(--easing),
      filter 0.6s ease,
      opacity 0.6s ease;
  }

  .slide[data-pos='center'] {
    z-index: 3;
    box-shadow: 0 30px 60px -30px var(--navy-shadow);
  }

  .slide[data-pos='left'],
  .slide[data-pos='right'] {
    z-index: 2;
    filter: blur(3px) brightness(0.75);
    cursor: pointer;
  }

  .slide[data-pos='left'] {
    transform: translateX(-62%) scale(0.84);
  }

  .slide[data-pos='right'] {
    transform: translateX(62%) scale(0.84);
  }

  .slide[data-pos^='hidden'] {
    z-index: 1;
    opacity: 0;
    pointer-events: none;
  }

  .slide[data-pos='hidden-left'] {
    transform: translateX(-95%) scale(0.7);
  }

  .slide[data-pos='hidden-right'] {
    transform: translateX(95%) scale(0.7);
  }

  .single .slide {
    width: var(--card);
  }

  @media (prefers-reduced-motion: reduce) {
    .slide {
      transition: opacity 0.2s ease;
    }
  }

  @media (max-width: 600px) {
    .slide {
      width: var(--card);
    }

    .slide[data-pos='left'],
    .slide[data-pos='right'] {
      filter: blur(3px) brightness(0.6);
    }

    .slide[data-pos='left'] {
      transform: translateX(-70%) scale(0.88);
    }

    .slide[data-pos='right'] {
      transform: translateX(70%) scale(0.88);
    }

    .current-title {
      display: none;
    }
  }

  /* Featured: landscape card, cover/video on the left, details on the right. */
  .featured {
    display: grid;
    grid-template-columns: minmax(0, 1.85fr) minmax(0, 1fr);
    overflow: hidden;
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-lg);
    background-color: var(--light-navy);
  }

  .media {
    position: relative;
    display: block;
    align-self: center;
    margin: 12px 0 12px 12px;
    overflow: hidden;
    border-radius: var(--radius-md);
    background: var(--dark-navy);
    aspect-ratio: 16 / 9;
  }

  .media :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s var(--easing);
  }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .featured:hover .media :global(img) {
      transform: scale(1.03);
    }
  }

  .body {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 14px;
    padding: 24px 28px;
  }

  .intro,
  .side {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .kind {
    margin: 0;
    color: var(--green);
    font-family: var(--font-mono);
    font-size: var(--fz-xs);
  }

  .featured h3 {
    margin: 0;
    font-size: clamp(22px, 3vw, 28px);
  }

  .featured h3 a:hover {
    color: var(--green);
  }

  /* Long descriptions are cut to six lines to keep the card compact. */
  .description {
    display: -webkit-box;
    -webkit-line-clamp: 6;
    -webkit-box-orient: vertical;
    overflow: hidden;
    margin: 0;
    color: var(--light-slate);
    font-size: var(--fz-md);
    line-height: 1.45;
  }

  .tech {
    margin: 0;
    color: var(--slate);
    font-family: var(--font-mono);
    font-size: var(--fz-xs);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 20px;
  }

  /* Tablets and phones: stack the cover above the details again. */
  @media (max-width: 900px) {
    .featured {
      grid-template-columns: 1fr;
    }

    .media {
      margin: 12px 12px 0;
    }

    .media :global(img) {
      height: auto;
      aspect-ratio: 16 / 9;
    }

    .body {
      padding: 22px 20px;
    }
  }

  /* Index header and filter */
  .index-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
    margin: 120px 0 12px;
  }

  .index-head h3 {
    margin: 0;
    font-size: var(--fz-xxl);
  }

  .all-button {
    margin-top: 32px;
  }

  @media (max-width: 480px) {
    .index-head {
      margin-top: 88px;
    }
  }
</style>
