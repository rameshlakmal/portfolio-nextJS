---
// Card grid for the /projects page: every project with its cover, a short
// description and labelled links, plus the Code / Writing filter.
import { Image } from 'astro:assets';
import HoverClip from './HoverClip.astro';
import { describe, external } from '../utils/projects.js';

interface Props {
  projects: object[];
}

const { projects } = Astro.props;
const cards = projects.map(describe);

const kindLabel = { app: 'Live app', writing: 'Article', code: 'Code' };

const filters = [
  { id: 'all', label: 'All', count: cards.length },
  { id: 'code', label: 'Code', count: cards.filter((c) => c.kinds.includes('code')).length },
  {
    id: 'writing',
    label: 'Writing',
    count: cards.filter((c) => c.kinds.includes('writing')).length,
  },
];
---

<div class="project-grid" data-project-grid>
  <div class="filters" role="group" aria-label="Filter projects">
    {filters.map((f, i) => (
      <button
        type="button"
        class="filter"
        aria-pressed={i === 0 ? 'true' : 'false'}
        data-filter={f.id}
      >
        {f.label}
        <span class="count">{f.count}</span>
      </button>
    ))}
  </div>

  <ul class="cards reset-list" data-reveal-items>
    {cards.map((card) => (
      <li class="card" data-kinds={card.kinds.join(' ')}>
        <div class="cover" aria-hidden="true">
          <Image
            src={card.cover}
            alt=""
            widths={[1200, 1600]}
            quality={90}
            sizes="(max-width: 640px) 100vw, 590px"
          />
          <HoverClip preview={card.preview} />
        </div>
        <div class="body">
          <p class="meta">
            {card.year} &middot; {kindLabel[card.links[0].kind]}
          </p>
          <h2 class="title">
            <a href={card.links[0].url} {...external(card.links[0].url)}>
              {card.title}
            </a>
          </h2>
          <p class="description">{card.description}</p>
          <p class="tech">{card.tech.join(', ')}</p>
          <div class="links">
            {card.links.map((link) => (
              <a class="text-link" href={link.url} {...external(link.url)}>
                {link.label} <span aria-hidden="true">↗</span>
              </a>
            ))}
          </div>
        </div>
      </li>
    ))}
  </ul>

  <p class="empty" hidden data-empty>
    No projects in this category yet.
  </p>
</div>

<script>
  import { playClip, stopClip, preloadWhenVisible } from '../utils/hoverClip';

  document.querySelectorAll<HTMLElement>('[data-project-grid]').forEach((root) => {
    const cards = [...root.querySelectorAll<HTMLElement>('.card')];
    const buttons = [...root.querySelectorAll<HTMLButtonElement>('[data-filter]')];
    const empty = root.querySelector<HTMLElement>('[data-empty]');
    const motion = document.documentElement.classList.contains('motion');

    // Covers with a clip play it while the card is hovered.
    cards.forEach((card) => {
      const clip = card.querySelector<HTMLVideoElement>('[data-clip]');
      if (!clip) return;
      preloadWhenVisible([clip]);
      card.addEventListener('pointerenter', () => playClip(clip));
      card.addEventListener('pointerleave', () => stopClip(clip));
    });

    // Soft light that follows the pointer across a card.
    cards.forEach((card) =>
      card.addEventListener('pointermove', (e) => {
        const rect = card.getBoundingClientRect();
        card.style.setProperty('--mx', `${e.clientX - rect.left}px`);
        card.style.setProperty('--my', `${e.clientY - rect.top}px`);
      }),
    );

    buttons.forEach((button) =>
      button.addEventListener('click', () => {
        const filter = button.dataset.filter!;
        buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === button)));
        let shown = 0;
        cards.forEach((card) => {
          const show = filter === 'all' || card.dataset.kinds!.split(' ').includes(filter);
          if (show && card.hidden && motion) {
            card.animate(
              [
                { opacity: 0, transform: 'translateY(10px)' },
                { opacity: 1, transform: 'none' },
              ],
              { duration: 320, easing: 'cubic-bezier(0.645, 0.045, 0.355, 1)' },
            );
          }
          card.hidden = !show;
          if (show) shown += 1;
        });
        if (empty) empty.hidden = shown > 0;
      }),
    );
  });
</script>

<style>
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    margin-bottom: 24px;
  }

  .filter {
    display: flex;
    align-items: center;
    gap: 8px;
    height: 40px;
    padding: 0 12px;
    border-radius: var(--radius-md);
    background: transparent;
    color: var(--slate);
    font-family: var(--font-mono);
    font-size: var(--fz-xs);
    transition: var(--transition);
  }

  .filter:hover {
    color: var(--lightest-slate);
  }

  .filter[aria-pressed='true'] {
    background-color: var(--green-tint);
    color: var(--green);
    box-shadow: var(--glow);
  }

  .count {
    color: var(--dark-slate);
  }

  .filter[aria-pressed='true'] .count {
    color: inherit;
    opacity: 0.7;
  }

  /* Two wide columns so the covers (and the text inside them) stay readable. */
  .cards {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
  }

  @media (max-width: 640px) {
    .cards {
      grid-template-columns: 1fr;
    }
  }

  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-lg);
    background-color: var(--light-navy);
    transition:
      border-color 0.25s ease,
      transform 0.25s var(--easing);
  }

  .card[hidden] {
    display: none;
  }

  /* Pointer-following light, shown on hover. */
  .card::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(
      300px circle at var(--mx, 50%) var(--my, 50%),
      rgba(var(--accent-rgb), 0.1),
      transparent 70%
    );
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  @media (hover: hover) {
    .card:hover {
      border-color: rgba(var(--accent-rgb), 0.4);
    }

    .card:hover::after {
      opacity: 1;
    }
  }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .card:hover {
      transform: translateY(-4px);
    }

    .card:hover .cover :global(img) {
      transform: scale(1.04);
    }
  }

  .cover {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-bottom: 1px solid var(--glass-border);
    background: var(--lightest-navy);
  }

  .cover :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s var(--easing);
  }

  .body {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    gap: 10px;
    padding: 18px 20px 20px;
  }

  .meta {
    margin: 0;
    color: var(--green);
    font-family: var(--font-mono);
    font-size: var(--fz-xxs);
  }

  .title {
    margin: 0;
    font-size: var(--fz-xl);
    line-height: 1.25;
  }

  /* The title link makes the whole card clickable; the text links sit above it. */
  .title a {
    position: static;
  }

  .title a::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .card:hover .title a {
    color: var(--green);
  }

  .description {
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
    margin: 0;
    color: var(--slate);
    font-size: var(--fz-md);
    line-height: 1.45;
  }

  .tech {
    margin: 0;
    color: var(--slate);
    font-family: var(--font-mono);
    font-size: var(--fz-xxs);
  }

  .links {
    position: relative;
    z-index: 2;
    display: flex;
    gap: 16px;
    margin-top: auto;
    padding-top: 6px;
  }

  .empty {
    margin: 24px 0 0;
    color: var(--slate);
  }
</style>
